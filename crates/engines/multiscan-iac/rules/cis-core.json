{
  "pack_id": "cis-core",
  "version": "1.1.0",
  "policies": [
    {
      "id": "cis-aws-s3-public-acl",
      "title": "S3 bucket grants public access via ACL",
      "resource_kinds": ["aws_s3_bucket"],
      "severity": "high",
      "cwe": ["CWE-284"],
      "compliance_controls": ["CIS-AWS-2.1.5", "NIST-800-53-AC-3"],
      "remediation": "Set the bucket ACL to private and enable S3 Block Public Access.",
      "condition": { "op": "in", "attribute": "acl", "values": ["public-read", "public-read-write"] }
    },
    {
      "id": "cis-aws-s3-no-encryption",
      "title": "S3 bucket has no server-side encryption configured",
      "resource_kinds": ["aws_s3_bucket"],
      "severity": "medium",
      "cwe": ["CWE-311"],
      "compliance_controls": ["CIS-AWS-2.1.1"],
      "remediation": "Add a server_side_encryption_configuration block enforcing AES256 or aws:kms.",
      "condition": { "op": "absent", "attribute": "server_side_encryption_configuration" }
    },
    {
      "id": "cis-aws-sg-open-ingress",
      "title": "Security group allows ingress from 0.0.0.0/0",
      "resource_kinds": ["aws_security_group"],
      "severity": "high",
      "cwe": ["CWE-284"],
      "compliance_controls": ["CIS-AWS-5.2"],
      "remediation": "Restrict ingress CIDR blocks to known networks.",
      "condition": { "op": "contains", "attribute": "ingress.cidr_blocks", "value": "0.0.0.0/0" }
    },
    {
      "id": "cis-aws-ebs-unencrypted",
      "title": "EBS volume is not encrypted",
      "resource_kinds": ["aws_ebs_volume"],
      "severity": "medium",
      "cwe": ["CWE-311"],
      "compliance_controls": ["CIS-AWS-2.2.1"],
      "remediation": "Set encrypted = true on the EBS volume.",
      "condition": { "op": "is_false_or_absent", "attribute": "encrypted" }
    },
    {
      "id": "cis-k8s-privileged-container",
      "title": "Container runs in privileged mode",
      "resource_kinds": ["Pod", "Deployment"],
      "severity": "high",
      "cwe": ["CWE-250"],
      "compliance_controls": ["CIS-K8S-5.2.1"],
      "remediation": "Set securityContext.privileged to false.",
      "condition": { "op": "is_true", "attribute": "spec.securityContext.privileged" }
    },
    {
      "id": "cis-docker-run-as-root",
      "title": "Container's final stage runs as root",
      "resource_kinds": ["dockerfile_stage"],
      "severity": "medium",
      "cwe": ["CWE-250"],
      "compliance_controls": ["CIS-DOCKER-4.1", "NIST-800-53-AC-6"],
      "remediation": "Add a non-root USER instruction to the final build stage.",
      "condition": {
        "op": "all",
        "conditions": [
          { "op": "is_true", "attribute": "is_final_stage" },
          { "op": "is_true", "attribute": "effective_user_root" }
        ]
      }
    },
    {
      "id": "cis-docker-add-remote-url",
      "title": "ADD fetches a remote URL",
      "resource_kinds": ["dockerfile_stage"],
      "severity": "medium",
      "cwe": ["CWE-829"],
      "compliance_controls": ["CIS-DOCKER-4.9"],
      "remediation": "Use COPY for local files; fetch remote content with a verified checksum instead of ADD <url>.",
      "condition": { "op": "is_true", "attribute": "adds_remote_url" }
    },
    {
      "id": "cis-docker-curl-pipe-shell",
      "title": "RUN pipes a network fetch into a shell",
      "resource_kinds": ["dockerfile_stage"],
      "severity": "high",
      "cwe": ["CWE-494"],
      "compliance_controls": ["NIST-800-53-SI-7"],
      "remediation": "Download to a file, verify its checksum or signature, then execute; do not pipe curl/wget straight into sh.",
      "condition": { "op": "is_true", "attribute": "curl_pipe_shell" }
    },
    {
      "id": "cis-docker-secret-in-env",
      "title": "Secret assigned in an ENV/ARG instruction",
      "resource_kinds": ["dockerfile_stage"],
      "severity": "high",
      "cwe": ["CWE-798"],
      "compliance_controls": ["CIS-DOCKER-4.10", "NIST-800-53-IA-5"],
      "remediation": "Never bake secrets into image layers; use build secrets (--mount=type=secret) or runtime injection.",
      "condition": { "op": "is_true", "attribute": "secret_in_env" }
    },
    {
      "id": "cis-docker-floating-base-tag",
      "title": "Base image uses a floating or missing tag",
      "resource_kinds": ["dockerfile_stage"],
      "severity": "low",
      "cwe": ["CWE-1104"],
      "compliance_controls": ["NIST-800-53-CM-2"],
      "remediation": "Pin the base image to a specific version tag or digest for reproducible builds.",
      "condition": { "op": "is_true", "attribute": "base_image_floating" }
    }
  ]
}
